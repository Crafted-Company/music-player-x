<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#151212</item>
        <item name="colorPrimaryDark">#151212</item>
        <item name="colorAccent">#D45B3E</item>
        <item name="android:statusBarColor">#151212</item>
        <item name="android:navigationBarColor">#151212</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">#151212</item>
        <item name="android:navigationBarColor">#151212</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:background">#151212</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#151212</item>
        <item name="android:navigationBarColor">#151212</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>